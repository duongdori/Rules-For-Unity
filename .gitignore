# ==============================================================================
# Git Ignore Rules for Google Antigravity Unity Rules & Development
# ==============================================================================

# Ensure core rule definitions and configurations are always tracked
!.agents/
!.agents/**
!AGENTS.md
!README.md

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs and Text Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / IntelliJ IDEA
.idea/
*.sln.DotSettings.user
.fleet/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates

# ------------------------------------------------------------------------------
# AI Agent Scratchpads & Local Workspace Overrides
# ------------------------------------------------------------------------------
scratch/
brain/
*.tmp
*.bak
*.swp
*.patch
*.diff

# ------------------------------------------------------------------------------
# Sensitive Information & Environment Files
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.secret
secrets.json

# ------------------------------------------------------------------------------
# Unity Generated Files (in case Unity projects/tests are placed in this workspace)
# ------------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Asset Store Cache / Packages
AssetStore-cache/
packages-lock.json

# Autogenerated Visual Studio / IDE project files for Unity
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & logs
sysinfo.txt
*.stackdump
UnityLockfile
